# ---------- Modo ----------
# mock = usa produtos de exemplo (não chama a Amazon). creators = Creators API real.
CATALOG_MODE=mock

# ---------- Amazon Associados / Creators API ----------
AMAZON_PARTNER_TAG=seutag-20
AMAZON_MARKETPLACE=www.amazon.com.br
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# Versão da credencial exibida no Associates Central (ex.: 3.1 ou 2.1). Brasil fica no grupo "North America".
AMAZON_CREDENTIAL_VERSION=3.1
# Deixe vazio para usar o endpoint padrão da versão; preencha se a Amazon indicar outro.
AMAZON_TOKEN_URL=
AMAZON_API_BASE=https://creatorsapi.amazon/catalog/v1
# Requisições por segundo permitidas (ajuste conforme sua cota)
AMAZON_RPS=1

# ---------- Conformidade ----------
# Idade máxima (min) do preço para liberar o envio. 0 = revalida sempre no clique de Enviar
# (garante que a promoção está ativa na hora do post). Outro valor aceita preço com até N min.
MAX_PRICE_AGE_MINUTES=0
# Acompanhar a oferta por 48h depois do envio e avisar quando a promoção acabar.
# false = não monitora nem avisa (o post é feito com a promoção ativa e pronto).
MONITOR_SENT_ENABLED=false
# Permitir exibir preços digitados manualmente (sem API). Por padrão NÃO: a política só autoriza preço vindo da API.
ALLOW_MANUAL_PRICES=false

# ---------- Texto (opcional: IA para a chamada/headline) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---------- Notificação opcional no Telegram (bot oficial) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Painel ----------
PANEL_USER=admin
# Obrigatória: mínimo 8 caracteres. O painel NÃO sobe com senha vazia, de exemplo ou muito comum.
PANEL_PASSWORD=Pe021003
# true quando o painel estiver atrás de HTTPS (cookie Secure + HSTS)
COOKIE_SECURE=false
# 127.0.0.1 = só esta máquina. Para acessar de outro aparelho use VPN (ex.: Tailscale) ou proxy HTTPS.
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/promo.db
NICHES_FILE=config/niches.yaml
TIMEZONE=America/Sao_Paulo
